# ---------------------------------------------------------------
# Aether Studio — roda LOCALMENTE (não é publicado na internet).
# Copie este arquivo para .env e preencha.
# ---------------------------------------------------------------

# Chave da API do Gemini, usada pelos agentes de redação.
GEMINI_API_KEY=""

# ---------------------------------------------------------------
# Supabase — ponte com o blog público
# ---------------------------------------------------------------
SUPABASE_URL="https://nxutdbhcedjcdfvsbrzt.supabase.co"

# service_role key (Project Settings > API > service_role).
# Ignora RLS e é a ÚNICA que consegue escrever na tabela `posts`.
# Como o Studio só roda na sua máquina, ela nunca é exposta ao público.
# NUNCA coloque esta chave no Aether-Blog.
SUPABASE_SERVICE_ROLE_KEY=""

# Bucket público onde as capas dos artigos são armazenadas.
SUPABASE_COVERS_BUCKET="article-covers"

# URL do blog público, usada pelo botão "Ver Blog".
VITE_PUBLIC_BLOG_URL="http://localhost:4321"

# ---------------------------------------------------------------
# Deploy hook da Vercel — fecha o ciclo da publicação
#
# O blog é um site estático: o HTML de cada artigo é gerado no build. Gravar
# no Supabase não coloca nada no ar sozinho; é este gancho que manda a Vercel
# reconstruir o site depois de publicar ou despublicar.
#
# Onde pegar: Vercel > projeto do blog > Settings > Git > Deploy Hooks >
# Create Hook (branch main). Copie a URL gerada.
#
# Sem esta variável, publicar continua funcionando — o artigo só aparece no
# próximo deploy, e o Studio avisa isso na mensagem de retorno.
# ---------------------------------------------------------------
VERCEL_DEPLOY_HOOK_URL=""
